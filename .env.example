# Instagram / Meta Graph API
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_ig_access_token
META_APP_SECRET=your_meta_app_secret
WEBHOOK_VERIFY_TOKEN=pick_any_random_string
GRAPH_API_VERSION=v22.0

# Google Gemini (Multimodal Free Tier)
GEMINI_API_KEY=your_gemini_api_key
# Recommended: gemini-3.6-flash or gemini-3.7-flash for high quality video and reel reasoning
GEMINI_MODEL=gemini-3.6-flash

# Telegram
TELEGRAM_BOT_TOKEN=your_botfather_token
TELEGRAM_CHAT_ID=your_chat_id

# Optional: Path to custom brand knowledge base / FAQ text file
KNOWLEDGE_BASE_FILE=knowledge_base.txt
PORT=8000
